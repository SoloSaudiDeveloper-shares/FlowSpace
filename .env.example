# ─────────────────────────────────────────────────────────────────────────
# FlowSpace environment variables
#
# Copy to `.env.local` and fill in the values you need. Everything here is
# OPTIONAL — FlowSpace boots with none of it set; each block just unlocks the
# corresponding feature. Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────

# ── Core ──
# Public base URL of this deployment (used in emails, OAuth redirects, links).
# No trailing slash. Example: https://flowspace.example.com
PUBLIC_APP_URL=http://localhost:3000

# Where the SQLite DB + uploads + backups live. Defaults to ./data.
# DATA_DIR=/var/lib/flowspace
# FLOWSPACE_DATA_DIR=/var/lib/flowspace

# ── Google OAuth (sign-in) + Google Calendar sync ──
# Create credentials at https://console.cloud.google.com (OAuth 2.0 Client).
# Authorized redirect URIs:
#   $PUBLIC_APP_URL/api/auth/google/callback
#   $PUBLIC_APP_URL/api/auth/google-calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Outbound email (password reset, "send as email", digests) ──
# Pick ONE transport. Resend takes priority if its key is set.
RESEND_API_KEY=
# ...or Gmail SMTP with an App Password (https://myaccount.google.com/apppasswords)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# From-address shown on outbound mail.
MAIL_FROM=
MAIL_FROM_NAME=FlowSpace

# ── Inbound email (email → notification → approve) ──
# Shared secret your inbound-mail webhook must present. REQUIRED in production —
# without it the inbound route would accept unauthenticated callers.
EMAIL_INBOUND_SECRET=

# ── Telegram voice transcription ──
# Groq Whisper API key for transcribing voice notes, or a self-hosted endpoint.
TELEGRAM_VOICE_GROQ_KEY=
# TELEGRAM_VOICE_LOCAL_URL=http://localhost:9000

# ── Local AI (Ollama) ──
# Base URL of a local Ollama server, if used as the AI provider.
# OLLAMA_URL=http://localhost:11434
